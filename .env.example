# Copy to .env and choose a password. .env is gitignored: never commit real values.
POSTGRES_PASSWORD=change-me
WAREHOUSE_DSN=postgresql://linkage:change-me@127.0.0.1:5433/warehouse
WAREHOUSE_TEST_DSN=postgresql://linkage:change-me@127.0.0.1:5433/linkage_test
# Generate with: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
